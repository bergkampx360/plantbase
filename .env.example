# Alkalmazás futásidejű változók (CLAUDE.md: "Application runtime variables belong in .env").
# Másold .env néven, töltsd ki, és soha ne commitold (lásd .gitignore).

# Prisma (read-write): séma, migráció, seed, ÉS a RAG-ingest (packages/core/src/rag/ingest.ts,
# getWritePool()) írása a knowledge_chunks táblába — ez utóbbi sosem az agent útján fut.
# Lásd docker-compose.yml (POSTGRES_USER/POSTGRES_DB: plantbase).
DATABASE_URL=postgresql://plantbase:<password>@localhost:5433/plantbase

# Az agent kapcsolata — kizárólag a read-only plantbase_ro szerepkörön keresztül
# (docs/architektura.md, 2. döntés; docker/postgres/initdb hozza létre). Két fogyasztója van:
# a runSql tool (products) és a searchKnowledge tool (knowledge_chunks, F6).
DATABASE_URL_READONLY=postgresql://plantbase_ro:<password>@localhost:5433/plantbase

# Anthropic API — az askAgent (packages/core) LLM-hívásaihoz.
ANTHROPIC_API_KEY=
# Alapértelmezett: claude-haiku-4-5 — az OpenAI gpt-4o-mini-hez hasonló kategóriájú,
# gyors/olcsó Anthropic modell (ld. docs/implementation/01-environment-and-agent-core.md
# "Rögzített technikai döntések"). Felülírható, pl. claude-sonnet-5-re, ha minőségi okból
# szükség lenne rá.
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI API — a RAG pipeline embedding- és rerank-lépéseihez (packages/core/src/rag,
# multi-provider routing indoklás: docs/architektura.md).
OPENAI_API_KEY=

# apps/server (G2) — opcionális, alapértelmezett érték van kódban.
# PORT: a szerver HTTP-portja (alapértelmezett: 3001).
# CORS_ORIGIN: az apps/web (G4) Vite dev-szerverének origin-je — a @nx/react:application
# generátor 4200-as portot állít be alapértelmezetten (nem az általános Vite-alapértelmezett
# 5173-at), ezért a kódbeli fallback és ez a példa is ezt tükrözi.
PORT=3001
CORS_ORIGIN=http://localhost:4200
