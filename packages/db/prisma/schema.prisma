datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// docs/stack.md — kategorikus mezők értékkészletei:
// category:   szobanövény / kerti / pozsgás / kaktusz / fűszer / fa-cserje / lógó / virágzó
// location:   beltéri / kültéri / mindkettő
// light:      árnyék / alacsony / közepes / erős / direkt nap
// watering:   ritka / közepes / gyakori / állandóan nedves
// difficulty: kezdő / haladó / profi
model Product {
  id                Int      @id @default(autoincrement())
  name              String
  latin_name        String   @unique
  category          String
  location          String
  price             Decimal
  sale_price        Decimal?
  stock             Int
  light             String
  watering          String
  difficulty        String
  current_height_cm Int
  max_height_cm     Int
  current_pot_cm    Int
  pet_safe          Boolean
  kid_safe          Boolean
  air_purifying     Boolean
  rating            Decimal
  reviews_count     Int
  description       String

  @@map("products")
}

// RAG tudásbázis (docs/rag-pipeline.md, F4-től) — a gondozási cikkek chunkjai + embeddingjei.
// Az agent (searchKnowledge tool, F6) csak a RO kapcsolaton olvassa; az ingest (F5) a RW
// kapcsolaton írja, ugyanaz az NFR1 elv, mint a products/runSql-nél.
model KnowledgeChunk {
  id         Int                     @id @default(autoincrement())
  source     String
  title      String
  category   String
  chunkIndex Int                     @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1536)")?

  @@map("knowledge_chunks")
}

// Webes chat előzmények (G rész, docs/implementation/06-web-chat.md, G3–G4) — alkalmazás-adat,
// nem agent-facing tudásbázis, ezért Prisma Clienten (RW) megy, nem a runSql/searchKnowledge RO
// poolján; nincs RO grant rá a db-role-setup skillben. A logs/ JSONL-naplózástól (CLI, audit-trail)
// független, párhuzamos mechanizmus — CLI és Web history-ja nem egyesül.
// Thread.id String, NEM autoincrement (G4-től) — az AI SDK useChat natív mintájában a chat id-t
// a kliens generálja (generateId(), az 'ai' csomagból) egy új beszélgetés indításakor, mielőtt az
// első üzenet elmenne; a szerver sosem talál ki saját azonosítót, csak arra perzisztál, amit kap.
// origin (J1, HF5, docs/implementation/09-customer-facing-poc.md, 8. döntés): 'internal' | 'customer'
// — a /api/customer/chat 'customer'-rel hozza létre a threadet, a /api/threads(/:id) alapértelmezésben
// csak 'internal'-t ad vissza, hogy az ügyfél-beszélgetések ne keveredjenek a lakberendezői
// előzményekkel a belső ThreadSidebar-ban.
model Thread {
  id        String    @id
  title     String?
  origin    String    @default("internal")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@map("threads")
}

// Ügyfél-eszkalációs sor (J1, HF5, docs/implementation/09-customer-facing-poc.md, 2. döntés) —
// az EGYETLEN tábla, amibe a customer-facing agent (requestHumanHandoff tool) valaha ír, egy
// szűk, INSERT-only DB-szerepkörön (DATABASE_URL_HANDOFF) keresztül, ami magát a táblát sem
// tudja visszaolvasni. Az agent sosem UPDATE-el/DELETE-el semmit, és sosem küld ki választ a
// customernek — azt csak egy ember teheti meg a staff felületen (/staff/handoffs, Prisma RW,
// apps/server), a status mezőt approved/rejected-re állítva.
model CustomerHandoff {
  id         Int       @id @default(autoincrement())
  question   String
  context    String?
  reason     String
  draftReply String?   @map("draft_reply")
  status     String    @default("pending")
  reviewer   String?
  reviewNote String?   @map("review_note")
  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")

  @@map("customer_handoffs")
}

model Message {
  id        Int      @id @default(autoincrement())
  threadId  String   @map("thread_id")
  thread    Thread   @relation(fields: [threadId], references: [id])
  role      String
  content   String
  // teljes UIMessage.parts tömb (szöveg + tool-hívás/-eredmény), csak assistant-
  // üzeneteknél töltve (H4, docs/implementation/07-web-ux-improvements.md) — a
  // content mező marad egyszerű szöveges fallback/napló céljából; a H4 előtti
  // sorokon null, a toUIMessages() kliens-oldali fallback-ja ekkor a content-et
  // egyetlen text part-tá alakítja
  parts     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}
