datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// docs/stack.md — kategorikus mezők értékkészletei:
// category:   szobanövény / kerti / pozsgás / kaktusz / fűszer / fa-cserje / lógó / virágzó
// location:   beltéri / kültéri / mindkettő
// light:      árnyék / alacsony / közepes / erős / direkt nap
// watering:   ritka / közepes / gyakori / állandóan nedves
// difficulty: kezdő / haladó / profi
model Product {
  id                Int      @id @default(autoincrement())
  name              String
  latin_name        String   @unique
  category          String
  location          String
  price             Decimal
  sale_price        Decimal?
  stock             Int
  light             String
  watering          String
  difficulty        String
  current_height_cm Int
  max_height_cm     Int
  current_pot_cm    Int
  pet_safe          Boolean
  kid_safe          Boolean
  air_purifying     Boolean
  rating            Decimal
  reviews_count     Int
  description       String

  @@map("products")
}

// RAG tudásbázis (docs/rag-pipeline.md, F4-től) — a gondozási cikkek chunkjai + embeddingjei.
// Az agent (searchKnowledge tool, F6) csak a RO kapcsolaton olvassa; az ingest (F5) a RW
// kapcsolaton írja, ugyanaz az NFR1 elv, mint a products/runSql-nél.
model KnowledgeChunk {
  id         Int                     @id @default(autoincrement())
  source     String
  title      String
  category   String
  chunkIndex Int                     @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1536)")?

  @@map("knowledge_chunks")
}

// Webes chat előzmények (G rész, docs/implementation/06-web-chat.md, G3) — alkalmazás-adat, nem
// agent-facing tudásbázis, ezért Prisma Clienten (RW) megy, nem a runSql/searchKnowledge RO
// poolján; nincs RO grant rá a db-role-setup skillben. A logs/ JSONL-naplózástól (CLI, audit-trail)
// független, párhuzamos mechanizmus — CLI és Web history-ja nem egyesül.
model Thread {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@map("threads")
}

model Message {
  id        Int      @id @default(autoincrement())
  threadId  Int      @map("thread_id")
  thread    Thread   @relation(fields: [threadId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}
