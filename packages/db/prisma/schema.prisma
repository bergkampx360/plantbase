datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// docs/stack.md — kategorikus mezők értékkészletei:
// category:   szobanövény / kerti / pozsgás / kaktusz / fűszer / fa-cserje / lógó / virágzó
// location:   beltéri / kültéri / mindkettő
// light:      árnyék / alacsony / közepes / erős / direkt nap
// watering:   ritka / közepes / gyakori / állandóan nedves
// difficulty: kezdő / haladó / profi
model Product {
  id                Int      @id @default(autoincrement())
  name              String
  latin_name        String   @unique
  category          String
  location          String
  price             Decimal
  sale_price        Decimal?
  stock             Int
  light             String
  watering          String
  difficulty        String
  current_height_cm Int
  max_height_cm     Int
  current_pot_cm    Int
  pet_safe          Boolean
  kid_safe          Boolean
  air_purifying     Boolean
  rating            Decimal
  reviews_count     Int
  description       String

  @@map("products")
}

// RAG tudásbázis (docs/rag-pipeline.md, F4-től) — a gondozási cikkek chunkjai + embeddingjei.
// Az agent (searchKnowledge tool, F6) csak a RO kapcsolaton olvassa; az ingest (F5) a RW
// kapcsolaton írja, ugyanaz az NFR1 elv, mint a products/runSql-nél.
model KnowledgeChunk {
  id         Int                     @id @default(autoincrement())
  source     String
  title      String
  category   String
  chunkIndex Int                     @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1536)")?

  @@map("knowledge_chunks")
}
